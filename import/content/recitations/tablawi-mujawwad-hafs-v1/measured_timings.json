     "ownBest": true
    },
    {
     "ayah": "60:2",
     "heard": "ان يسقفواكم يكونوا لكم اردا ويبسوا اليكم ايديهم وانسلتهم بالسو ووضعوا لو تفسون",
     "scores": {
