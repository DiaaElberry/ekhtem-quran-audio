    {
     "ayah": "4:60",
     "heard": "الم تري الي الذين يزعومون انهم امنوا بما انزل اليك وما انزل من قبلك يريدون ان يتحاكموا الي الطاغوت وقد امروا ان يكفروا به ويريد الشيطان ان يضل لهم ضلالا بعيدا",
     "scores": {
      "59": 0.252,
      "60": 0.987,
      "61": 0.354
     },
     "ownBest": true
    },
    {
     "ayah": "4:61",
     "heard": "واذا قيل لهم تعالوا الي ما انزل الله والي الرسول رايت المنافقين يصدون عنك صدودا",
     "scores": {
      "60": 0.395,
      "61": 1.0,
      "62": 0.373
     },
     "ownBest": true
    },
    {
     "ayah": "4:62",
     "heard": "فكيف اذا اصابتهم مصيبه بما قدمت ايديهم ثم جاوا كيحلفون بالله ان اردنا الا احسانا وتوفيقا",
     "scores": {
      "61": 0.371,
      "62": 0.983,
      "63": 0.226
     },
     "ownBest": true
    },
    {
     "ayah": "4:63",
     "heard": "اوليك الذين يعلموا الله ما في قلوبهم فاعرض عنهم وعظهم وقل لهم في انفسين قولا بليغا",
     "scores": {
      "62": 0.237,
      "63": 0.963,
      "64": 0.337
     },
     "ownBest": true
    },
    {
     "ayah": "4:64",
     "heard": "وما ارسلنا من رسول الا ليقاع باذن الله ولو انهم اذ ظلموا انفسهم جاواك فاستغفروا الله واستغفر لهم رسول لو جدوا الله توابر رحيما",
     "scores": {
      "63": 0.359,
      "64": 0.968,
      "65": 0.308
     },
     "ownBest": true
    },
    {
     "ayah": "4:65",
     "heard": "فلا وربك لا يومنون حتي يحكموا كفي ما شجر بينهم ثم لا يجدوا في انفسهم حرجا من ما قضيت ويسلموا تسلينا",
     "scores": {
      "64": 0.338,
      "65": 0.959,
      "66": 0.388
     },
     "ownBest": true
    },
    {
     "ayah": "4:66",
     "heard": "ولو انا كتبنا عليهم ان قتلوا انفسكم او اخرجوا من دياركم ما فعلوه الا قليل منهم ولو انهم فعلوا ما يعظون به لكان خيرا لهم واشد تثبيتا",
     "scores": {
      "65": 0.257,
      "66": 0.992,
      "67": 0.245
     },
     "ownBest": true
    },
    {
     "ayah": "4:67",
     "heard": "واذا لاتيناهم من لدنا اجرا عظيما",
     "scores": {
      "66": 0.23,
      "67": 1.0,
      "68": 0.473
     },
     "ownBest": true
    },
    {
     "ayah": "4:68",
     "heard": "ولهديناهم صراطا مستقيما",
     "scores": {
      "67": 0.509,
      "68": 1.0,
      "69": 0.229
     },
     "ownBest": true
    },
    {
     "ayah": "4:69",
     "heard": "ومن يقع الله ورسول فاوليك مع الذين انعموا الله عليهم من النبيين والصديقين والشهدا والصالحين وحسن اوليك رفيقا",
     "scores": {
      "68": 0.198,
      "69": 0.972,
      "70": 0.282
     },
     "ownBest": true
    },
    {
     "ayah": "4:70",
     "heard": "ذلك الفضل من الله وكفي بالله علينا",
     "scores": {
      "69": 0.31,
      "70": 0.971,
      "71": 0.344
     },
     "ownBest": true
    },
    {
     "ayah": "4:71",
     "heard": "يا ايها الذين امنوا خذوا حذركم فانفروا ثبات او انفروا جميعا",
     "scores": {
      "70": 0.258,
      "71": 1.0,
      "72": 0.246
     },
     "ownBest": true
    },
    {
     "ayah": "4:72",
     "heard": "وان منكم لمن لا يبط ان فان اصابتكم مصيبه قال قال قد انعم الله علي اذ لم اكم معهم شهيدا",
     "scores": {
      "71": 0.221,
